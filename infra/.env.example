# Copy this file to infra/.env before running Docker Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=ordermgmt
MYSQL_USER=ordermgmt_app
MYSQL_PASSWORD=replace-with-a-strong-app-password

# Base64-encoded JWT signing key. Generate at least 32 random bytes, then Base64 encode them.
JWT_SECRET=replace-with-a-base64-encoded-32-byte-or-longer-secret
# Optional token lifetimes in milliseconds. Defaults: access 30 minutes; refresh 7 days.
JWT_ACCESS_TOKEN_TTL_MS=1800000
JWT_REFRESH_TOKEN_TTL_MS=604800000

# MinIO Console administrator. Use a unique, strong password (at least 8 characters).
MINIO_ROOT_USER=ordermgmt_admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# Least-privilege credentials consumed by the Spring Boot service only.
# Do not expose these in the browser; the backend will later issue presigned URLs.
MINIO_APP_ACCESS_KEY=ordermgmt_app
MINIO_APP_SECRET_KEY=replace-with-a-strong-minio-app-password
