# ==========================================================================
# 课程作业 · 本地演示配置
#
# 以下数值是公开的演示值，可直接使用：
#   Copy-Item infra\.env.example infra\.env
#
# 这些值已随仓库公开，只能用于本机演示，切勿用于任何真实部署。
# 所有端口只绑定 127.0.0.1，同一局域网的其他机器无法访问。
# ==========================================================================

MYSQL_ROOT_PASSWORD=demo-root-7ty3vNmrxP46I7Tv
MYSQL_DATABASE=ordermgmt
MYSQL_USER=ordermgmt_app
MYSQL_PASSWORD=demo-app-PG51x4j72Df5SOBO

# JWT signing key: Base64 of 32 random bytes (must decode to at least 256 bits).
JWT_SECRET=2XcqcBQNpAWbyzwOq/t2OemNfavFwSRAMiAdHk8kex0=
JWT_ACCESS_TOKEN_TTL_MS=1800000
JWT_REFRESH_TOKEN_TTL_MS=604800000

# SeaweedFS S3 identity used by the backend (object read/write only).
S3_ACCESS_KEY=ordermgmt_app
S3_SECRET_KEY=demo-s3-X0OzhL8pq5ex0Jh7YV0x
S3_BUCKET=ordermgmt
# SeaweedFS S3 identity used only by the one-shot init container (creates the bucket). Must differ from the above.
S3_ADMIN_ACCESS_KEY=ordermgmt_admin
S3_ADMIN_SECRET_KEY=demo-s3admin-IMoxtCRkGGIeICmJ

# Address embedded in presigned URLs; the browser must be able to reach it.
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Browser origins allowed to upload/download through presigned URLs (Vite dev server and Nginx).
# Applied as the SeaweedFS gateway flag -s3.allowedOrigins; recreate the seaweedfs container after changing it.
S3_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
